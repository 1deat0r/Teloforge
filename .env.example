# Local development only. Copy to .env and choose your own password.
TELOFORGE_PORT=4100
POSTGRES_USER=teloforge_dev
POSTGRES_DB=teloforge_dev
POSTGRES_PASSWORD=replace-with-local-development-password
# Future persistence connection. The scaffold does not connect to this database.
DATABASE_URL=postgresql://teloforge_dev:replace-with-local-development-password@127.0.0.1:55432/teloforge_dev
# Future artifact location. No runner/provider credentials belong in this file.
TELOFORGE_ARTIFACT_DIR=.data/artifacts
